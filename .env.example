# ===========================================
# Vedo Bookkeeping - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# === DATABASE (Required) ===
# PostgreSQL connection string (Neon recommended)
# Get yours at: https://neon.tech
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# === SESSION (Required) ===
# Random secret for session encryption (min 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-secret-key-at-least-32-characters-long

# === SERVER ===
NODE_ENV=development
PORT=5000

# === RESEND - Email Sending (Optional) ===
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender email (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=invoices@yourdomain.com

# === STRIPE - Payment Processing (Optional) ===
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# === PLAID - Bank Connections (Optional) ===
# Get your keys at: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
# Options: sandbox, development, production

# === OPENAI - AI Features (Optional) ===
# Get your key at: https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxx
# Optional: Custom base URL for OpenAI-compatible APIs
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# === EXCHANGE RATES (Optional) ===
# Get your key at: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=your-exchangerate-api-key

# === RADAR - Address Autocomplete (Optional) ===
# Get your key at: https://radar.com/
RADAR_API_KEY=your-radar-api-key
